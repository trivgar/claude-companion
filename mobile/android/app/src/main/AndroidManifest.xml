<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Comms: a push from CompanionApp (app/commsapp.py) wakes the player. -->
        <service
            android:name=".CommsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".CommsPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- Android's answer to the app's own update (Updater). -->
        <receiver
            android:name=".Updater$Status"
            android:exported="false">
            <intent-filter>
                <action android:name="${applicationId}.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
        <!-- A notification's words, fetched in the foreground (NoteService). -->
        <service
            android:name=".NoteService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
        <!-- Caller calls: Android's own call system rings the phone (RingConnection). -->
        <service
            android:name=".RingConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
        <service
            android:name=".RingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
        <activity
            android:name=".RingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/AppTheme.NoActionBar" />
        <receiver
            android:name=".RingActions"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Caller calls (app/ring.py, step 2): a self-managed call, its own ring screen. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- navigator.vibrate in the WebView (static/haptics.js) needs it. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Restart the phone's Termux sshd (TermuxSshd): Termux's own permission. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <!-- The live call's microphone (static/call.js), for CompanionApp's own page
         only (CallChromeClient). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
