[Unit]
Description=claude-companion: merge the queued branches (tests once, then PRs)

[Service]
Type=oneshot
# Assumes the repo is cloned at ~/claude-companion with a venv in .venv
# (INSTALL.md step 4). gh must be signed in as the user that owns the queue.
WorkingDirectory=%h/claude-companion
Environment=PATH=%h/claude-companion/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/claude-companion/.venv/bin/python -m claude_companion.mergeq run --if-queued
# A full suite can take a while.
TimeoutStartSec=2h
