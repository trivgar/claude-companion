[Unit]
Description=agent-companion: the dashboard server for your Claude Code sessions
After=network.target

[Service]
Type=simple
# Assumes the repo is cloned at ~/agent-companion with a venv in .venv
# (INSTALL.md step 4). Edit these two lines if yours lives elsewhere.
WorkingDirectory=%h/agent-companion
ExecStart=%h/agent-companion/.venv/bin/python -m agent_companion.server
# claude, gh and tailscale live in ~/.local/bin or /usr/local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
